# =====================================================================
# BrandSure backend settings. Copy this file to backend/.env and fill in.
# Lines marked  >>> FILL IN <<<  are the blanks for services you want to turn on.
# Leave a blank empty and that feature stays off; the app still works.
# =====================================================================

# ---- Core ----
APP_ENV=development                       # "production" turns off demo accounts and requires SECRET_KEY
FRONTEND_ORIGIN=http://localhost:5173
DB_PATH=brandsure.db
MAX_UPLOAD_MB=10
SECRET_KEY=change-me-to-a-long-random-string   # signs login tokens; REQUIRED in production
TOKEN_TTL_HOURS=12
SEED_DEMO=true                            # creates a demo organisation with 3 accounts on first run
ALLOW_REGISTRATION=true
DEMO_LOGIN=true                           # one-click demo buttons on the login page (default: on in development, off in production)
DEMO_CONTENT=true                         # load the sample TechNova kit and posts (needs SEED_DEMO=true)
EVAL_DATE=                                # optional YYYY-MM-DD for reproducible demos

# ---- AI (optional)  >>> FILL IN <<< ----
# Turns on: tone and claim judgement, rule extraction from guidelines, alt-text suggestions.
# Without it everything still runs with built-in offline checks and nothing leaves your server.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_URL=https://api.anthropic.com/v1/messages

# ---- Slack notifications (optional)  >>> FILL IN <<< ----
# Create an "Incoming Webhook" in Slack and paste its URL.
SLACK_WEBHOOK_URL=

# ---- OCR for scanned PDFs (optional) ----
# No key needed. Install the Tesseract program and `pip install pytesseract` (see docs/INTEGRATIONS.md).
OCR_ENABLED=true
OCR_LANG=eng

# ---- Supabase Auth (optional)  >>> FILL IN <<< ----
# AUTH_PROVIDER=local uses BrandSure's own accounts. Set to "supabase" and fill the values below to use Supabase.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # server only; lets admins create users
SUPABASE_JWT_SECRET=                      # optional: Project Settings > API > JWT secret (faster local token checks)

# ---- Google Docs import ----
# Nothing to fill in. Works for documents shared as "Anyone with the link can view".
